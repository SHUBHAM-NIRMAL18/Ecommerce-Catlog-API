# Copy to .env only to override defaults. Docker Compose and local dev both work without it.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
# Local dev only. Inside Docker the API always uses db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seed (python manage.py seed) and image folder; default to data/ in the repo
# CATALOG_FILE=../data/catalog.json
# IMAGES_DIR=../data/images

# API
PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
# API_URL: how the Next.js server reaches the API (always http://api:8000 inside Docker)
API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL: how the browser reaches the API (baked in when the web image is built)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Compose host ports. The URLs above follow these when not set.
API_PORT=8000
WEB_PORT=3000
